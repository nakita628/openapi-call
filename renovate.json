{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":separateMultipleMajorReleases", "security:openssf-scorecard"],
  "timezone": "Asia/Tokyo",
  "schedule": ["* * * * 6"],
  "dependencyDashboardAutoclose": true,
  "osvVulnerabilityAlerts": true,
  "labels": ["dependencies"],
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* * * * 6"]
  },
  "packageRules": [
    {
      "matchDatasources": ["npm", "github-actions"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "TypeSpec ships every @typespec/* package in one release and the packages require each other's version as peers, so they move in one PR.",
      "matchPackageNames": ["@typespec/**"],
      "groupName": "typespec",
      "separateMajorMinor": false,
      "separateMultipleMajor": false
    },
    {
      "matchUpdateTypes": ["pin", "pinDigest"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest"],
      "automerge": false
    },
    {
      "description": "vite-plus ships its own Vite and Vitest, which pnpm-workspace.yaml overrides to the versions it bundles (`vp toolchain vitest`), so the three move in one PR and are never automerged: the override versions are checked by hand.",
      "matchPackageNames": ["vite-plus", "@voidzero-dev/vite-plus-core", "vitest"],
      "groupName": "vite-plus",
      "automerge": false
    }
  ]
}
